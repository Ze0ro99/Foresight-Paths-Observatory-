# Configure these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets or paste them into chat.

# Required for AI-powered event analysis.
GEMINI_API_KEY=

# Pi Platform server key. Keep server-side only; never prefix with NEXT_PUBLIC_.
PI_API_KEY=

# Testnet payment approval/completion requires both flags plus PI_API_KEY and SUPABASE_SERVICE_ROLE_KEY.
PI_PAYMENTS_ENABLED=false
PI_PAYMENT_INTENT_LEDGER_READY=false

# Keep false: no prepaid balance or paid entitlement is delivered by this project yet.
PI_ENTITLEMENT_LEDGER_ENABLED=false

# Additional explicit approval required before enabling real Mainnet payment operations.
PI_MAINNET_PAYMENTS_APPROVED=false

# This app is registered on Pi Testnet; this value does not select or enable Mainnet.
PI_NETWORK=Pi Testnet

# Direct Pi Testnet mode. Set both server and browser settings to false for direct SDK use.
# Set PI_DIRECT_TESTNET_ENABLED=false unless the registered Pi Testnet app is intentionally tested directly.
PI_SANDBOX_MODE=false
PI_DIRECT_TESTNET_ENABLED=true
NEXT_PUBLIC_PI_SANDBOX_MODE=false

# App session encryption secret (server-only, at least 32 characters).
PI_APP_SESSION_SECRET=

# Optional Pi Sign-In OAuth configuration; client ID and redirect URI are public settings.
NEXT_PUBLIC_PI_OAUTH_CLIENT_ID=
NEXT_PUBLIC_PI_OAUTH_REDIRECT_URI=

# Foresight Paths isolated development project. Publishable key is public/read-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key for private payment-intent RPCs; never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
